<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="620"
        d:DesignHeight="560"
        Width="620"
        Height="560"
        MinWidth="480"
        MinHeight="520"
        x:Class="minutnik.MainWindow"
        Title="Minutnik pracy">
    <Grid Background="#F3F5F9">
        <Border Margin="32"
                Padding="36"
                Background="White"
                CornerRadius="20"
                BoxShadow="0 8 30 0 #180E1B35">
            <Grid RowDefinitions="Auto,*,Auto,Auto">
                <StackPanel Spacing="8">
                    <TextBlock Text="MINUTNIK"
                               FontSize="13"
                               FontWeight="Bold"
                               Foreground="#697386"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Skup się na tym, co ważne"
                               FontSize="25"
                               FontWeight="SemiBold"
                               Foreground="#182230"
                               HorizontalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Row="1"
                            VerticalAlignment="Center"
                            Spacing="18">
                    <Border Padding="12,6"
                            Background="#EAF2FF"
                            CornerRadius="20"
                            HorizontalAlignment="Center">
                        <TextBlock x:Name="PhaseText"
                                   Text="Czas pracy"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#2859A5" />
                    </Border>

                    <TextBlock x:Name="TimerText"
                               Text="25:00"
                               FontSize="80"
                               FontWeight="Bold"
                               Foreground="#182230"
                               HorizontalAlignment="Center" />

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Spacing="8">
                        <TextBlock Text="Ukończone cykle:"
                                   FontSize="15"
                                   Foreground="#697386"
                                   VerticalAlignment="Center" />
                        <TextBlock x:Name="CycleCountText"
                                   Text="0"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#182230"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>

                <Border Grid.Row="2"
                        Padding="18"
                        Background="#F7F8FA"
                        CornerRadius="12">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Długość etapów"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#344054" />
                        <Grid ColumnDefinitions="*,*"
                              ColumnSpacing="16">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Praca (min)"
                                           FontSize="13"
                                           Foreground="#697386" />
                                <NumericUpDown x:Name="WorkDurationInput"
                                               Minimum="1"
                                               Maximum="180"
                                               Value="25"
                                               Increment="1"
                                               FormatString="0"
                                               ClipValueToMinMax="True" />
                            </StackPanel>
                            <StackPanel Grid.Column="1"
                                        Spacing="6">
                                <TextBlock Text="Przerwa (min)"
                                           FontSize="13"
                                           Foreground="#697386" />
                                <NumericUpDown x:Name="BreakDurationInput"
                                               Minimum="1"
                                               Maximum="60"
                                               Value="5"
                                               Increment="1"
                                               FormatString="0"
                                               ClipValueToMinMax="True" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Row="3"
                            Margin="0,20,0,0"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Spacing="12">
                    <Button x:Name="StartPauseButton"
                            Content="Start"
                            Width="150"
                            Height="46"
                            Background="#315FC4"
                            Foreground="White"
                            FontSize="15"
                            FontWeight="SemiBold"
                            Click="OnStartPauseClick" />
                    <Button Content="Resetuj"
                            Width="120"
                            Height="46"
                            FontSize="15"
                            Click="OnResetClick" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
